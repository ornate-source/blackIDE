{
  "name": "black-ide-agent",
  "displayName": "Black IDE Agent",
  "description": "Built-in AI coding assistant and agentic loop engine for Black IDE",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "blackide",
  "engines": {
    "vscode": "^1.90.0"
  },
  "enabledApiProposals": [
    "contribSourceControlInputBoxMenu"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:black-ide-chat-view",
    "onView:black-ide-office-view"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "blackide": "./bin/blackide"
  },
  "contributes": {
    "commands": [
      {
        "command": "black-ide.openSettings",
        "title": "\u2726 Black IDE Settings",
        "icon": "$(gear)"
      },
      {
        "command": "black-ide.generateCommitMessage",
        "title": "Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "black-ide.inlineEdit",
        "title": "Black IDE: Inline Edit",
        "icon": "$(sparkle)"
      },
      {
        "command": "black-ide.openOffice",
        "title": "\u2726 Black IDE: Agent Office",
        "icon": "$(organization)"
      },
      {
        "command": "black-ide.openPipelineManager",
        "title": "\u2726 Black IDE: Pipeline Manager",
        "icon": "$(run-all)"
      },
      {
        "command": "black-ide.exportDiagnostics",
        "title": "\u2726 Black IDE: Export Agent Diagnostics",
        "icon": "$(output)"
      },
      {
        "command": "black-ide.installBrowserSupport",
        "title": "\u2726 Black IDE: Install Browser Support",
        "icon": "$(cloud-download)"
      },
      {
        "command": "black-ide.installSkillPacks",
        "title": "\u2726 Black IDE: Install Skill Packs",
        "icon": "$(book)"
      },
      {
        "command": "black-ide.reviewChanges",
        "title": "\u2726 Black IDE: Review Working Changes",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "black-ide.postReviewToPr",
        "title": "\u2726 Black IDE: Post Review to Pull Request",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "black-ide.addSkillFrom",
        "title": "\u2726 Black IDE: Add Skill Pack From URL",
        "icon": "$(cloud-download)"
      },
      {
        "command": "black-ide.addDocs",
        "title": "\u2726 Black IDE: Add Docs",
        "icon": "$(book)"
      },
      {
        "command": "black-ide.manageDocs",
        "title": "\u2726 Black IDE: Manage Docs",
        "icon": "$(library)"
      },
      {
        "command": "black-ide.nextEdit.jump",
        "title": "\u2726 Black IDE: Jump to Next Edit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "black-ide.nextEdit.dismiss",
        "title": "\u2726 Black IDE: Dismiss Next Edit"
      },
      {
        "command": "black-ide.nextEdit.showStats",
        "title": "\u2726 Black IDE: Next-Edit Statistics"
      },
      {
        "command": "black-ide.terminalCommand",
        "title": "\u2726 Black IDE: Generate Terminal Command",
        "icon": "$(terminal)"
      },
      {
        "command": "black-ide.compactConversation",
        "title": "\u2726 Black IDE: Compact Conversation"
      }
    ],
    "keybindings": [
      {
        "command": "black-ide.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "black-ide.nextEdit.jump",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "editorTextFocus && blackIde.nextEditAvailable"
      },
      {
        "command": "black-ide.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && blackIde.nextEditAvailable && !suggestWidgetVisible && !inlineSuggestionVisible && !renameInputVisible && !findWidgetVisible"
      },
      {
        "command": "black-ide.terminalCommand",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "black-ide.openSettings",
          "group": "navigation",
          "order": 1
        }
      ],
      "global/activity": [
        {
          "command": "black-ide.openSettings",
          "group": "2_configuration",
          "order": 1.5
        },
        {
          "command": "black-ide.openOffice",
          "group": "2_configuration",
          "order": 1.4
        }
      ],
      "scm/inputBox": [
        {
          "command": "black-ide.generateCommitMessage",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "black-ide-chat",
          "title": "Black Agent",
          "icon": "resources/agent-sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "black-ide-chat": [
        {
          "id": "black-ide-chat-view",
          "type": "webview",
          "name": "Chat",
          "icon": "resources/agent-sidebar-icon.svg",
          "initialSize": 5
        },
        {
          "id": "black-ide-office-view",
          "type": "webview",
          "name": "Agent Office",
          "icon": "resources/office-sidebar-icon.svg",
          "contextualTitle": "Black Agent",
          "initialSize": 2
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "build-webview": "cd webview && npm run build",
    "test": "tsc -b && npm run build-store-test && node test/harness.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:all": "npm run test && npm run test:unit && npm run eval",
    "eval": "tsc -b && node eval/run-eval.js",
    "eval:record": "tsc -b && node eval/run-eval.js --json",
    "build-store-test": "tsc webview/src/agent-store.ts --outDir test/dist-store --module commonjs --target es2020 --skipLibCheck",
    "lint:css": "stylelint 'webview/src/**/*.css'",
    "lint:dead-code": "knip",
    "compile-integration": "tsc -p test/integration",
    "test:integration": "npm run compile && npm run compile-integration && node test/integration/out/runTest.js"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "@blackide/agent-core": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "knip": "^5.0.0",
    "mocha": "^10.8.2",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*"
  ]
}
